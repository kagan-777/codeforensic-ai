{
  "name": "codeforensic-ai",
  "version": "1.0.0",
  "private": true,
  "description": "Evidence-based static analysis with AI-powered security explanations for students and beginner developers.",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
